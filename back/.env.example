# Puerto donde corre la API
PORT=2026

# Conexion a MongoDB (local o Atlas)
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://usuario:password@cluster.mongodb.net/?appName=recetario
MONGO_URI= mongodb+srv://admin:<db_password>@dwt4ap-juegos-retro.o6zrtb6.mongodb.net/
DNS_SERVERS=1.1.1.1,8.8.8.8

# Nombre de la base de datos
DB_NAME=recetario

# Clave con la que se firman los JWT
JWT_SECRET=cambiar_esta_clave

# Duracion del token
JWT_EXPIRES=2h

# Origen permitido por CORS (el del frontend)
CORS_ORIGIN=http://localhost:5173
